# Copia este archivo como .env y completa los valores. El .env no se sube al repo.

# Django. La clave secreta es una frase larga al azar, distinta para cada computador o servidor.
DJANGO_SECRET_KEY=
# 1 = muestra errores detallados (solo para buscar un problema). Normalmente va 0.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL en Docker). Inventa una contraseña.
POSTGRES_DB=finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=

# Conectar un banco (opcional). Llaves de modo prueba en app.fintoc.com > Para desarrolladores > API Keys.
FINTOC_SECRET_KEY=sk_test_...
FINTOC_PUBLIC_KEY=pk_test_...

# Asistente "Pregúntale a FinFlow" (opcional). Llave gratis en console.groq.com > API Keys.
GROQ_API_KEY=

# Inicio de sesión con Google (opcional). ID de cliente OAuth (tipo "Aplicación web") de
# console.cloud.google.com, con origen autorizado http://localhost:3000
GOOGLE_CLIENT_ID=

# Correo de contacto que aparece en la política de privacidad (opcional).
CONTACT_EMAIL=

# 1 solo al publicar con HTTPS: cookies seguras y redirección a HTTPS.
DJANGO_HTTPS=0
