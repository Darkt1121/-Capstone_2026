# Copia este archivo como .env y pega tus llaves. El .env no se sube al repo.
# Las llaves de prueba están en app.fintoc.com > Para desarrolladores > API Keys.
FINTOC_SECRET_KEY=sk_test_...
FINTOC_PUBLIC_KEY=pk_test_...
PORT=3000

# Asistente "Pregúntale a FinFlow" (opcional). Llave gratis en console.groq.com > API Keys.
GROQ_API_KEY=

# Inicio de sesión con Google. ID de cliente OAuth (tipo "Aplicación web") de console.cloud.google.com.
# Origen autorizado: http://localhost:3000
GOOGLE_CLIENT_ID=

# Base de datos (PostgreSQL en Docker). Inventa una contraseña y repítela en DATABASE_URL.
POSTGRES_DB=finflow
POSTGRES_USER=finflow
POSTGRES_PASSWORD=
DATABASE_URL=postgres://finflow:TU_CONTRASEÑA@localhost:5433/finflow

# Correo de contacto que aparece en la política de privacidad (opcional).
CONTACT_EMAIL=
